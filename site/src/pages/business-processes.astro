---
import Base from "../layouts/Base.astro";
import HeroTessellation from "../components/HeroTessellation.astro";
import CatalogBrowser from "../components/catalog/CatalogBrowser.tsx";
import { bpFlat, valueStreams, version } from "../data/load.ts";

const totalProcesses = version.process_count ?? bpFlat.length;
---

<Base
  title="Business Processes"
  description="Browse, filter, and export the open business-process catalog. Verb-phrased activities anchored on APQC PCF's 4-level hierarchy."
  navTransparent={true}
>
  <HeroTessellation
    title="Business Processes"
    description={`${totalProcesses} ${totalProcesses === 1 ? "process node" : "process nodes"} · catalog ${version.catalogue_version} · schema v${version.schema_version}`}
  />

  <main class="main">
    {bpFlat.length === 0 ? (
      <div class="bp-empty">
        <p>
          The business-process catalogue is currently scaffolded but empty —
          schema, lint, build pipeline, and CLI are all in place. APQC PCF
          Cross-Industry import lands in a follow-up PR.
        </p>
        <p>
          Add a BP1 file at <code>catalogue/processes/BP1-&lt;slug&gt;.yaml</code>,
          register it in <code>catalogue/processes/_index.yaml</code>, then run
          <code>npm run lint</code>.
        </p>
      </div>
    ) : (
      <CatalogBrowser kind="process" data={bpFlat} valueStreams={valueStreams} client:load />
    )}
  </main>
</Base>

<style>
  .bp-empty {
    padding: 24px;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm, 8px);
    background: var(--color-white);
    color: var(--color-muted);
    max-width: 720px;
    margin: 24px 0;
  }
  .bp-empty code {
    background: var(--color-pale-blue);
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 12px;
  }
</style>
