---
import Base from "../../layouts/Base.astro";
import { bpFlat, getBpById, getBpAncestors, getStageById, getById } from "../../data/load.ts";

export function getStaticPaths() {
  return bpFlat.map((b) => ({
    params: { id: b.id },
    props: { id: b.id },
  }));
}

interface Props {
  id: string;
}
const { id } = Astro.props as Props;
const node = getBpById(id);
if (!node) {
  throw new Error(`Business process ${id} not found at build time`);
}
const ancestors = getBpAncestors(id);
const directChildren = bpFlat.filter((b) => b.parent_id === id);
const successor = node.successor_id ? getBpById(node.successor_id) : null;
const githubUrl = `https://github.com/vincentmakes/turbo-ea-capabilities/tree/main/catalogue/processes`;

const realizesCaps = (node.realizes_capability_ids ?? [])
  .map((bcId) => getById(bcId))
  .filter((c): c is NonNullable<ReturnType<typeof getById>> => Boolean(c));

const realizedInStages = (node.realized_in_value_streams ?? [])
  .map((sid) => getStageById(sid))
  .filter((x): x is NonNullable<ReturnType<typeof getStageById>> => Boolean(x));
---

<Base
  title={`${node.id} · ${node.name}`}
  description={node.description ?? `Business Process ${node.id} - ${node.name}.`}
>
  <main class="main">
    <nav class="detail-breadcrumb">
      <a href="/business-processes">Processes</a>
      {ancestors.map((a) => (
        <>
          <span class="sep">/</span>
          <a href={`/business-process/${a.id}`}>{a.name}</a>
        </>
      ))}
      <span class="sep">/</span>
      <span>{node.name}</span>
    </nav>

    <article class="detail-card">
      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <span class="cap-id" style="font-size: 14px; padding: 4px 10px;">{node.id}</span>
        <span class="cap-level">L{node.level}</span>
        {node.deprecated && <span class="cap-deprecated-badge">Deprecated</span>}
      </div>
      <h1 style="font-size: 32px; margin-top: 8px;">{node.name}</h1>

      {node.deprecated && (
        <div class="deprecation-banner">
          <strong>Deprecated.</strong> {node.deprecation_reason}
          {successor && (
            <>
              {" "}Successor: <a href={`/business-process/${successor.id}`}>{successor.id} {successor.name}</a>.
            </>
          )}
        </div>
      )}

      {node.description && (
        <p style="margin-top: 16px; font-size: 16px; line-height: 1.7;">{node.description}</p>
      )}

      <div class="detail-meta-grid">
        {node.industry && (
          <div>
            <div class="meta-key">Industry</div>
            <div class="meta-val">{node.industry}</div>
          </div>
        )}
        {node.aliases && node.aliases.length > 0 && (
          <div>
            <div class="meta-key">Aliases</div>
            <div class="meta-val">{node.aliases.join(", ")}</div>
          </div>
        )}
        {node.framework_refs && node.framework_refs.length > 0 && (
          <div>
            <div class="meta-key">Framework refs</div>
            <div class="meta-val">
              {node.framework_refs.map((fr) => (
                <div>
                  <strong>{fr.framework}</strong>
                  {fr.version && <> ({fr.version})</>}
                  {": "}
                  {fr.url ? <a href={fr.url} target="_blank" rel="noopener">{fr.external_id}</a> : fr.external_id}
                </div>
              ))}
            </div>
          </div>
        )}
        {node.references && node.references.length > 0 && (
          <div>
            <div class="meta-key">References</div>
            <div class="meta-val">
              {node.references.map((r) => (
                <div><a href={r} target="_blank" rel="noopener">{r}</a></div>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="permalink-row">
        <a class="btn" href={`/api/business-process/${node.id}.json`}>Raw JSON</a>
        <a class="btn" href={githubUrl} target="_blank" rel="noopener">View on GitHub</a>
      </div>
    </article>

    {directChildren.length > 0 && (
      <section>
        <div class="section-header">
          <h2>Children ({directChildren.length})</h2>
        </div>
        <div class="cap-list">
          {directChildren.map((c) => (
            <a class="cap-list-row" href={`/business-process/${c.id}`}>
              <span class="cap-id">{c.id}</span>
              <span class="cap-name">{c.name}</span>
              <span class="cap-level">L{c.level}</span>
              {c.deprecated && <span class="cap-deprecated-badge">Deprecated</span>}
            </a>
          ))}
        </div>
      </section>
    )}

    {realizesCaps.length > 0 && (
      <section>
        <div class="section-header">
          <h2>Realizes Capabilities ({realizesCaps.length})</h2>
        </div>
        <div class="cap-list">
          {realizesCaps.map((c) => (
            <a class="cap-list-row" href={`/capability/${c.id}`}>
              <span class="cap-id">{c.id}</span>
              <span class="cap-name">{c.name}</span>
              <span class="cap-level">L{c.level}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {realizedInStages.length > 0 && (
      <section>
        <div class="section-header">
          <h2>Used in Value Streams ({realizedInStages.length})</h2>
        </div>
        <ul class="cap-list">
          {realizedInStages.map(({ stream, stage }) => (
            <li class="cap-list-row">
              <a href={`/value-streams#${stream.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
                <span class="cap-id">{stage.id}</span>
                <span class="cap-name">
                  <strong>{stream.name}</strong> · stage {stage.stage_order} ({stage.stage_name})
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Base>
