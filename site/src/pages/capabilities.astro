---
import Base from "../layouts/Base.astro";
import HeroTessellation from "../components/HeroTessellation.astro";
import CatalogueBrowser from "../components/CatalogueBrowser.tsx";
import { flatWithMacros, macros, valueStreams, version } from "../data/load.ts";

const macroSummary =
  macros.length > 0 ? ` · ${macros.length} macro capabilities` : "";
---

<Base
  title="Capabilities"
  description="Browse, filter, and export the open Business Capability catalog."
  navTransparent={true}
>
  <HeroTessellation
    title="Business Capabilities"
    tagline={`${version.node_count} capabilities${macroSummary}`}
    description={`Catalog ${version.catalogue_version} · schema v${version.schema_version}`}
  />

  <main class="main">
    <CatalogueBrowser data={flatWithMacros} valueStreams={valueStreams} client:load />
  </main>
</Base>
