---
// SPDX-License-Identifier: MIT
import Base from "../layouts/Base.astro";
import HeroTessellation from "../components/HeroTessellation.astro";
import CatalogBrowser from "../components/catalog/CatalogBrowser.tsx";
import { valueStreams, version } from "../data/load.ts";
import { valueStreamsAsTree } from "../data/value-streams-as-tree.ts";

const data = valueStreamsAsTree(valueStreams);
const stageCount = data.filter((n) => n.level === 2).length;
---

<Base
  title="Value Streams"
  description="Browse, filter, and export the open value-stream catalog. Trigger-to-outcome flows whose stages link the capabilities and processes that participate at each step."
  navTransparent={true}
>
  <HeroTessellation
    title="Value Streams"
    tagline={`${valueStreams.length} ${valueStreams.length === 1 ? "stream" : "streams"} · ${stageCount} ${stageCount === 1 ? "stage" : "stages"}`}
    description={`Catalog ${version.catalogue_version} · schema v${version.schema_version}`}
  />

  <main class="main">
    {valueStreams.length === 0 ? (
      <div class="bp-empty">
        <p>
          The value-stream catalogue is currently empty. Add streams to
          <code>catalogue/_value-streams.yaml</code>, then run <code>npm run lint</code>.
        </p>
      </div>
    ) : (
      <CatalogBrowser kind="value-stream" data={data} client:load />
    )}
  </main>
</Base>

<style>
  .bp-empty {
    padding: 24px;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm, 8px);
    background: var(--color-white);
    color: var(--color-muted);
    max-width: 720px;
    margin: 24px 0;
  }
  .bp-empty code {
    background: var(--color-pale-blue);
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 12px;
  }
</style>
